# Which provider query_engine.py uses: "gemini" (default), "openrouter",
# "groq", "claude", or "huggingface"
ACTIVE_PROVIDER=gemini

# --- Optional cloud providers (only needed if ACTIVE_PROVIDER is set to one of these) ---

# OpenRouter
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini
# GEMINI_MODEL=gemini-flash-latest
# GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-3B-Instruct
# HF_TOKEN=your_huggingface_token_here

# Groq
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# Claude (Anthropic API)
# CLAUDE_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Embeddings (vector store) ---
# Which sentence-transformers model embeds PDF chunks + queries. Default is
# BAAI/bge-small-en-v1.5. Options roughly in increasing quality/size order:
#   BAAI/bge-small-en-v1.5               (~130MB, default, fastest)
#   BAAI/bge-base-en-v1.5                (~440MB, stronger BEIR scores)
#   mixedbread-ai/mxbai-embed-large-v1   (~1.3GB, top-tier open embedding model)
#   sentence-transformers/all-MiniLM-L6-v2  (~90MB, general-purpose baseline)
# IMPORTANT: changing this requires re-indexing - delete chroma_db/ (the
# persist_dir) and re-run ingestion, since a collection's embedding
# dimensionality is fixed at creation.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Guardrail (age/scope check, runs before every query) ---
# Blocks questions that are off-topic (not science/maths) or age-inappropriate,
# with a friendly refusal - no LLM call, runs locally via the embedding model
# above. Default on. See src/query_scope_and_age_guardrail.py.
# GUARDRAIL_ENABLED=true
